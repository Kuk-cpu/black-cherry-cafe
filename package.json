{
  "name": "black-cherry-cafe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/dev.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit.test.ts tests/media.test.ts tests/menu-upgrade.test.ts tests/production.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-black-cherry --only auth,firestore",
    "seed": "node --import tsx scripts/seed.ts",
    "admin": "tsx scripts/create-admin.ts",
    "test:all": "firebase emulators:exec --project demo-black-cherry --only auth,firestore 'npm run seed && npm run accounts:local && npm run test:integration && npm run test:e2e'",
    "format": "prettier --write .",
    "preview:full": "concurrently -k \"tsx server/dev.ts\" \"vite preview --host 127.0.0.1 --port 5173\"",
    "images:placeholder": "node --import tsx scripts/media/placeholder.ts",
    "images:optimize": "node --import tsx scripts/media/optimize.ts",
    "images:audit": "node --import tsx scripts/media/audit.ts",
    "images:audit:dev": "node --import tsx scripts/media/audit.ts --dev",
    "prebuild": "node --import tsx scripts/check-production.ts --if-hosted && npm run images:audit",
    "test:media": "vitest run tests/media.test.ts",
    "images:report": "node --import tsx scripts/media/report.ts",
    "images:illustrate": "node --import tsx scripts/illustrations/generate.ts",
    "accounts:local": "node --import tsx scripts/local-accounts.ts",
    "production:check": "node --import tsx scripts/check-production.ts",
    "build:production": "npm run production:check && npm run build"
  },
  "dependencies": {
    "@google-cloud/firestore": "7.11.6",
    "dotenv": "^16.4.0",
    "firebase": "^12.0.0",
    "firebase-admin": "13.6.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^15.34.1",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
