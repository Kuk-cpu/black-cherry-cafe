# Public Firebase web app identifiers, not Admin credentials. Never put service-account keys in VITE_*.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-black-cherry.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-black-cherry
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
# Local only. REMOVE both emulator host variables in Vercel.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-black-cherry
# Production only; private key must include escaped \n between lines.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Use a long random value in production; HMAC hashes rate-limit IPs.
RATE_LIMIT_SECRET=local-emulator-secret
APP_ORIGIN=http://localhost:5173
